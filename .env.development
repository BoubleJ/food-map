# 로컬 개발용 기본값. docker-compose.dev.yml 의 컨테이너와 짝을 이룬다.
NODE_ENV=development

# --- DB / 캐시 ---
POSTGRES_USER=foodmap
POSTGRES_PASSWORD=foodmap
POSTGRES_DB=foodmap
DATABASE_URL=postgres://foodmap:foodmap@localhost:5432/foodmap
REDIS_URL=redis://localhost:6380

# --- API ---
API_PORT=4000
API_URL=http://localhost:4000
JWT_SECRET=dev-only-change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
COOKIE_DOMAIN=localhost
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# --- 소셜 로그인 (발급 후 채운다) ---
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# --- web / admin ---
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_KAKAO_MAP_JS_KEY=
