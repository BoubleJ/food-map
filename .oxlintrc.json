{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["eslint", "typescript", "unicorn", "oxc", "react", "import", "vitest"],
  "jsPlugins": [
    {
      "name": "barrel-files",
      "specifier": "eslint-plugin-barrel-files"
    }
  ],
  "categories": {
    "correctness": "error"
  },
  "env": {
    "browser": true,
    "node": true
  },
  "ignorePatterns": ["apps/admin/src/routeTree.gen.ts"],
  "rules": {
    "eslint/no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_"
      }
    ],
    "barrel-files/avoid-barrel-files": [
      "error",
      {
        "amountOfExportsToConsiderModuleAsBarrel": 1
      }
    ],
    "barrel-files/avoid-re-export-all": "error",
    "no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "group": ["./*", "../*", "!./+types/*"],
            "message": "@/ 절대경로 alias 를 쓴다."
          }
        ]
      }
    ]
  },
  "overrides": [
    {
      "files": ["packages/shared/**"],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ]
}
