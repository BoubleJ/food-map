{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["eslint", "typescript", "unicorn", "oxc", "react", "import", "vitest"],
  "jsPlugins": [
    {
      "name": "barrel-files",
      "specifier": "eslint-plugin-barrel-files"
    },
    {
      "name": "food-map",
      "specifier": "./packages/oxlint-plugin/src/index.ts"
    }
  ],
  "settings": {
    "food-map": {
      "roleFolders": {
        "types": "type",
        "utils": "function",
        "constants": "constant",
        "dto": "class"
      },
      "nestFileKinds": ["module", "controller", "service"],
      "sharedFolder": "shared",
      "sharedChildFolders": [
        "decorators",
        "filters",
        "guards",
        "interceptors",
        "middleware",
        "pipes"
      ],
      "infraFolders": {
        "database": ["schema"]
      }
    }
  },
  "categories": {
    "correctness": "error"
  },
  "env": {
    "browser": true,
    "node": true
  },
  "ignorePatterns": ["apps/admin/src/routeTree.gen.ts"],
  "rules": {
    "eslint/no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_"
      }
    ],
    "barrel-files/avoid-barrel-files": [
      "error",
      {
        "amountOfExportsToConsiderModuleAsBarrel": 1
      }
    ],
    "barrel-files/avoid-re-export-all": "error",
    "no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "group": ["./*", "../*", "!./+types/*"],
            "message": "@/ 절대경로 alias 를 쓴다."
          }
        ]
      }
    ],
    "food-map/no-restaurant-value-union": "error"
  },
  "overrides": [
    {
      "files": ["packages/**"],
      "rules": {
        "no-restricted-imports": "off"
      }
    },
    {
      "files": ["apps/web/**", "apps/admin/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["./*", "../*", "!./+types/*"],
                "message": "@/ 절대경로 alias 를 쓴다."
              }
            ],
            "paths": [
              {
                "name": "react",
                "importNames": ["default", "memo", "useMemo", "useCallback"],
                "message": "memo, useMemo, useCallback 을 쓰지 않는다. default import 는 React.useMemo 로 우회할 수 있어 같이 막는다."
              }
            ]
          }
        ],
        "prefer-destructuring": [
          "error",
          {
            "VariableDeclarator": {
              "object": true,
              "array": false
            },
            "AssignmentExpression": {
              "object": false,
              "array": false
            }
          }
        ],
        "react/function-component-definition": [
          "error",
          {
            "namedComponents": "function-declaration",
            "unnamedComponents": "arrow-function"
          }
        ],
        "react/jsx-handler-names": [
          "error",
          {
            "eventHandlerPrefix": "handle",
            "eventHandlerPropPrefix": "on",
            "checkLocalVariables": true,
            "checkInlineFunction": false
          }
        ],
        "typescript/consistent-type-definitions": ["error", "interface"],
        "typescript/no-inferrable-types": "error",
        "food-map/no-type-prefix": "error",
        "food-map/prefer-props-with-children": "error",
        "food-map/no-nested-type-literal": "error",
        "react/rules-of-hooks": "error",
        "react/unsupported-syntax": "error",
        "react/rule-suppression": "error",
        "react/capitalized-calls": "error"
      }
    },
    {
      "files": ["apps/api/**"],
      "rules": {
        "food-map/no-foreign-internal-import": "error",
        "food-map/no-exported-function-in-nest-file": "error",
        "unicorn/filename-case": [
          "error",
          {
            "case": "kebabCase"
          }
        ],
        "food-map/export-kind-by-folder": "error",
        "food-map/nest-file-location": "error"
      }
    }
  ]
}
