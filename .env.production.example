# 배포 서버에서 .env.production 으로 복사한 뒤 값을 채운다. (.env.production 은 커밋하지 않는다)
NODE_ENV=production

# --- DB / 캐시 ---
POSTGRES_USER=foodmap
POSTGRES_PASSWORD=__CHANGE_ME__
POSTGRES_DB=foodmap
DATABASE_URL=postgres://foodmap:__CHANGE_ME__@postgres:5432/foodmap
REDIS_URL=redis://redis:6379

# --- API ---
API_PORT=4000
API_URL=https://api.example.com
JWT_SECRET=__CHANGE_ME__
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
COOKIE_DOMAIN=.example.com
CORS_ORIGINS=https://example.com,https://admin.example.com

# --- 소셜 로그인 (발급 후 채운다) ---
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# --- web / admin ---
NEXT_PUBLIC_API_URL=https://api.example.com
NEXT_PUBLIC_KAKAO_MAP_JS_KEY=
