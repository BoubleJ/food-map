{
  "name": "food-map",
  "private": true,
  "packageManager": "pnpm@10.11.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "db:up": "docker compose --env-file .env.dev -f docker-compose.dev.yml up -d",
    "db:down": "docker compose --env-file .env.dev -f docker-compose.dev.yml down"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild", "sharp", "unrs-resolver", "@tailwindcss/oxide"]
  },
  "devDependencies": {
    "turbo": "2.11.4",
    "typescript": "6.0.3"
  }
}
