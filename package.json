{
  "name": "food-map",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "oxlint && zsh scripts/check-api-structure.sh",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "db:tunnel": "ssh -N -o ExitOnForwardFailure=yes foodmap-dev"
  },
  "devDependencies": {
    "eslint-plugin-barrel-files": "^3.0.1",
    "lefthook": "^2.1.14",
    "oxfmt": "^0.70.0",
    "oxlint": "1.85.0",
    "turbo": "^2.11.4",
    "typescript": "^6.0.3"
  },
  "packageManager": "pnpm@10.11.0",
  "pnpm": {
    "packageExtensions": {
      "eslint-plugin-barrel-files": {
        "peerDependenciesMeta": {
          "eslint": {
            "optional": true
          }
        }
      }
    },
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "unrs-resolver",
      "@tailwindcss/oxide",
      "lefthook"
    ]
  }
}
