{
  "name": "food-map",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "oxlint && zsh scripts/check-api-structure.sh",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "db:tunnel": "nc -z 127.0.0.1 15432 || ssh -f -N -M -S ~/.ssh/foodmap-dev.sock -o ExitOnForwardFailure=yes -o ServerAliveInterval=30 -o ServerAliveCountMax=3 foodmap-dev",
    "db:tunnel:close": "ssh -S ~/.ssh/foodmap-dev.sock -O exit foodmap-dev 2>/dev/null || echo 'pnpm db:tunnel 로 연 터널이 없다'",
    "api:dev": "pnpm db:tunnel && pnpm --filter @food-map/api dev"
  },
  "devDependencies": {
    "eslint-plugin-barrel-files": "^3.0.1",
    "lefthook": "^2.1.14",
    "oxfmt": "^0.70.0",
    "oxlint": "1.85.0",
    "turbo": "^2.11.4",
    "typescript": "^6.0.3"
  },
  "packageManager": "pnpm@10.11.0",
  "pnpm": {
    "packageExtensions": {
      "eslint-plugin-barrel-files": {
        "peerDependenciesMeta": {
          "eslint": {
            "optional": true
          }
        }
      }
    },
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "unrs-resolver",
      "@tailwindcss/oxide",
      "lefthook"
    ]
  }
}
